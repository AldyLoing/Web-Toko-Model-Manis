# ============================================
# Model Manis - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it contains sensitive data
#
# Usage:
#   cp .env.example .env
#   Edit .env with your actual credentials
# ============================================

# ============================================
# Django Configuration
# ============================================

# SECRET_KEY: Django secret key for cryptographic signing
# Generate new key for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-CHANGE-THIS-TO-A-SECURE-KEY

# DEBUG: Set to True for development, False for production
DEBUG=True

# ALLOWED_HOSTS: Comma-separated list of allowed hosts
# Example: localhost,127.0.0.1,yourdomain.com,*.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Shopee API Configuration
# ============================================

# SHOPEE_SHOP_ID: Your Shopee store ID
# Find at: https://shopee.co.id/[your-store] -> View Page Source -> search for "shopid"
SHOPEE_SHOP_ID=53252649

# SHOPEE_PROXY: Cloudflare Worker URL for bypassing API restrictions
# Deploy worker from cloudflare-worker/shopee-proxy.js first
# Example: https://shopee-proxy.your-account.workers.dev
SHOPEE_PROXY=

# SHOPEE_STORE_URL: Public URL of your Shopee store
# Example: https://shopee.co.id/modelmanis34
SHOPEE_STORE_URL=https://shopee.co.id/modelmanis34

# ============================================
# Instagram API Configuration (Optional)
# ============================================

# INSTAGRAM_ACCESS_TOKEN: Instagram Basic Display API access token
# Get from: https://developers.facebook.com/apps/
# Steps:
#   1. Create Facebook App
#   2. Add Instagram Basic Display product
#   3. Configure OAuth redirect URI
#   4. Generate access token
# WARNING: Keep this token private! Never commit to Git
INSTAGRAM_ACCESS_TOKEN=

# INSTAGRAM_PROFILE_URL: Public URL of your Instagram profile
# Example: https://instagram.com/modelmanis34
INSTAGRAM_PROFILE_URL=https://instagram.com/modelmanis34

# ============================================
# Cache Configuration
# ============================================

# API_CACHE_TIMEOUT: Cache duration in seconds (default: 300 = 5 minutes)
# Increase for better performance, decrease for more real-time data
API_CACHE_TIMEOUT=300

# ============================================
# Production Settings (Vercel/Serverless)
# ============================================

# For production deployment, set these in your hosting platform's dashboard:
# - Vercel: Project Settings -> Environment Variables
# - Netlify: Site Settings -> Environment Variables
# - Railway: Project Settings -> Variables
#
# Production checklist:
# ✓ Generate new SECRET_KEY
# ✓ Set DEBUG=False
# ✓ Add production domain to ALLOWED_HOSTS
# ✓ Never use default/example values
# ✓ Rotate keys periodically
# ✓ Enable HTTPS only (handled by Vercel)

# ============================================
# Security Best Practices
# ============================================
#
# 1. NEVER commit .env to version control
# 2. Use different keys for dev/staging/production
# 3. Rotate compromised keys immediately
# 4. Use strong, random SECRET_KEY
# 5. Keep Instagram tokens private
# 6. Enable 2FA on all service accounts
# 7. Review access logs regularly
#
# If you accidentally commit secrets:
#   1. Revoke the compromised key immediately
#   2. Generate new key
#   3. Update all deployments
#   4. Clean Git history: git filter-branch or BFG Repo-Cleaner
#
# ============================================
